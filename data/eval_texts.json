   "وما علينا الا البلاغ المبين",
   "ونفس وما سواها",
   "ونمارق مصفوفه",
   "ويتجنبها الاشقي",
   "يوم ينفخ في الصور فتاتون افواجا",
   "۞ افلا يعلم اذا بعثر ما في القبور"
  ]
 }
}